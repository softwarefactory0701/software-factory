{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@software-factory/website#build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_DEMOS_BASE_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@software-factory/demos#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
